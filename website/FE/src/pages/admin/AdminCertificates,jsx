function getCertificateEndpoint() {
  if (import.meta.env.VITE_CERTIFICATE_API_URL) {
    return import.meta.env.VITE_CERTIFICATE_API_URL;
  }

  return 'http://localhost/arduflowapiworkshop/api/certificate-api.php';
}

