function buildCertificateEndpoint(params = {}) {
  const url = new URL(CERTIFICATE_ENDPOINT, window.location.origin);

  Object.entries(params).forEach(([key, value]) => {
    if (value !== undefined && value !== null && String(value) !== '') {
      url.searchParams.set(key, value);
    }
  });

  return url.toString();
}

function resolveBackendAssetUrl(value) {
  if (!value) {
    return '';
  }

  const rawValue = String(value);

  if (/^(https?:)?\/\//i.test(rawValue) || rawValue.startsWith('blob:') || rawValue.startsWith('data:')) {
    return rawValue;
  }

  try {
    const endpointUrl = new URL(CERTIFICATE_ENDPOINT, window.location.origin);
    const basePath = endpointUrl.pathname.replace(/\/api\/[^/]*$/i, '');
    const normalizedPath = rawValue.startsWith('/') ? rawValue : `/${rawValue}`;

    return `${endpointUrl.origin}${basePath}${normalizedPath}`;
  } catch (error) {
    return rawValue;
  }
}

function getCertificateFileUrl(file) {
  if (!file) {
    return '';
  }

  if (typeof file === 'string') {
    return resolveBackendAssetUrl(file);
  }

  return resolveBackendAssetUrl(file.url || file.file_url || file.relativeUrl || file.relative_url || '');
}

function safeText(value, fallback = '-') {
  const text = value === null || value === undefined ? '' : String(value).trim();

  return text || fallback;
}

function formatDate(value) {
  if (!value) {
    return '-';
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return new Intl.DateTimeFormat('id-ID', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);
}

function loadImage(src) {
  return new Promise((resolve, reject) => {
    const image = new Image();
    image.onload = () => resolve(image);
    image.onerror = reject;
    image.src = src;
  });
}

function canvasToBlob(canvas, type = 'image/png', quality = 0.92) {
  return new Promise((resolve, reject) => {
    canvas.toBlob((blob) => {
      if (blob) {
        resolve(blob);
        return;
      }

      reject(new Error('Gagal membuat file sertifikat.'));
    }, type, quality);
  });
}

async function canvasToPdfBlob(canvas) {
  const imageBlob = await canvasToBlob(canvas, 'image/jpeg', 0.94);
  const imageBytes = new Uint8Array(await imageBlob.arrayBuffer());
  const pageWidth = 960;
  const pageHeight = Math.round((pageWidth * canvas.height) / canvas.width);
  const offsets = [];
  const chunks = [];
  let offset = 0;

  const append = (chunk) => {
    chunks.push(chunk);
    offset += typeof chunk === 'string' ? chunk.length : chunk.byteLength;
  };
  const addObject = (objectNumber, parts) => {
    offsets[objectNumber] = offset;
    append(`${objectNumber} 0 obj\n`);
    parts.forEach(append);
    append('\nendobj\n');
  };

  append('%PDF-1.4\n');
  addObject(1, ['<< /Type /Catalog /Pages 2 0 R >>']);
  addObject(2, ['<< /Type /Pages /Kids [3 0 R] /Count 1 >>']);
  addObject(3, [
    `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageWidth} ${pageHeight}] `,
    '/Resources << /XObject << /CertImage 4 0 R >> >> /Contents 5 0 R >>',
  ]);
  addObject(4, [
    `<< /Type /XObject /Subtype /Image /Width ${canvas.width} /Height ${canvas.height} `,
    `/ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${imageBytes.byteLength} >>\nstream\n`,
    imageBytes,
    '\nendstream',
  ]);

  const content = `q\n${pageWidth} 0 0 ${pageHeight} 0 0 cm\n/CertImage Do\nQ`;
  addObject(5, [`<< /Length ${content.length} >>\nstream\n${content}\nendstream`]);

  const xrefOffset = offset;
  append(`xref\n0 6\n0000000000 65535 f \n${offsets
    .slice(1)
    .map((item) => `${String(item).padStart(10, '0')} 00000 n \n`)
    .join('')}trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF`);

  return new Blob(chunks, { type: 'application/pdf' });
}

function wrapCanvasText(context, text, maxWidth) {
  const words = String(text || '').split(/\s+/).filter(Boolean);
  const lines = [];
  let currentLine = '';

  words.forEach((word) => {
    const testLine = currentLine ? `${currentLine} ${word}` : word;

    if (context.measureText(testLine).width > maxWidth && currentLine) {
      lines.push(currentLine);
      currentLine = word;
      return;
    }

    currentLine = testLine;
  });

  if (currentLine) {
    lines.push(currentLine);
  }

  return lines;
}

function drawCenteredText(context, text, x, y, maxWidth, lineHeight, maxLines = 3) {
  const lines = wrapCanvasText(context, text, maxWidth).slice(0, maxLines);
  const offset = ((lines.length - 1) * lineHeight) / 2;

  lines.forEach((line, index) => {
    context.fillText(line, x, y - offset + index * lineHeight);
  });
}

function formatCertificateDate(value) {
  if (!value) {
    return formatDate(new Date().toISOString().slice(0, 10));
  }

  return formatDate(value);
}

async function generateCertificateBlob(certificate) {
  const template = await loadImage(certificateTemplate);
  const canvas = document.createElement('canvas');
  canvas.width = template.naturalWidth || template.width;
  canvas.height = template.naturalHeight || template.height;

  const context = canvas.getContext('2d');
  const width = canvas.width;
  const height = canvas.height;
  const scaleX = width / 1492;
  const scaleY = height / 1054;
  const fontScale = Math.min(scaleX, scaleY);

  context.drawImage(template, 0, 0, width, height);
  context.textAlign = 'center';
  context.textBaseline = 'middle';
  context.fillStyle = '#071a38';

  const patchArea = (x, y, patchWidth, patchHeight, sourceX = 1120, sourceY = 472, sourceWidth = 130, sourceHeight = 130) => {
    context.drawImage(
      template,
      sourceX,
      sourceY,
      sourceWidth,
      sourceHeight,
      x * scaleX,
      y * scaleY,
      patchWidth * scaleX,
      patchHeight * scaleY,
    );
  };
  const clearTextArea = (x, y, patchWidth, patchHeight, alpha = 0.96) => {
    context.save();
    context.fillStyle = `rgba(255, 253, 249, ${alpha})`;
    context.fillRect(x * scaleX, y * scaleY, patchWidth * scaleX, patchHeight * scaleY);
    context.restore();
  };

  clearTextArea(382, 480, 728, 104);
  clearTextArea(315, 600, 862, 130);
  clearTextArea(505, 718, 478, 50);
  clearTextArea(265, 778, 398, 46, 0.94);
  clearTextArea(890, 778, 460, 46, 0.94);
  clearTextArea(250, 925, 300, 48, 0.94);
  clearTextArea(960, 925, 330, 48, 0.94);
  context.fillStyle = '#071a38';

  context.font = `700 ${Math.round(50 * fontScale)}px Georgia, 'Times New Roman', serif`;
  drawCenteredText(context, safeText(certificate.userName, 'NAMA PESERTA').toUpperCase(), width / 2, 535 * scaleY, 640 * scaleX, 56 * scaleY, 2);

  context.font = `400 ${Math.round(24 * fontScale)}px Georgia, 'Times New Roman', serif`;
  drawCenteredText(
    context,
    certificate.description || 'Atas partisipasinya dan keberhasilan mengikuti kegiatan Workshop Arduflow IDE.',
    width / 2,
    652 * scaleY,
    690 * scaleX,
    30 * scaleY,
    3,
  );

  context.font = `700 ${Math.round(24 * fontScale)}px Georgia, 'Times New Roman', serif`;
  context.fillText(`Diselenggarakan oleh ${certificate.organizer || 'Arduflow'}`, width / 2, 735 * scaleY);

  context.font = `400 ${Math.round(18 * fontScale)}px Georgia, 'Times New Roman', serif`;
  context.textAlign = 'left';
  context.fillText(`Tanggal: ${formatCertificateDate(certificate.issuedAt || certificate.completedAt)}`, 288 * scaleX, 802 * scaleY);
  context.fillText(`Nomor Sertifikat: ${certificate.certificateNumber}`, 1000 * scaleX, 802 * scaleY);

  context.textAlign = 'center';
  context.font = `500 ${Math.round(18 * fontScale)}px Georgia, 'Times New Roman', serif`;
  drawCenteredText(context, certificate.instructor || 'Instruktur', 408 * scaleX, 957 * scaleY, 250 * scaleX, 22 * scaleY, 2);
  drawCenteredText(context, certificate.organizer || 'Penyelenggara', 1138 * scaleX, 957 * scaleY, 280 * scaleX, 22 * scaleY, 2);

  return canvasToPdfBlob(canvas);
}

function normalizeCertificate(row) {
  const payload = row?.payload || {};
  const file = row?.file || payload.file || payload.certificateFile || null;
  const userName = row?.userName || row?.user_name || payload.userName || payload.user?.name || '';
  const email = row?.email || payload.email || payload.user?.email || '';
  const workshopTitle =
    row?.workshopTitle ||
    row?.workshop_title ||
    row?.programTitle ||
    payload.workshopTitle ||
    payload.programTitle ||
    payload.workshop?.title ||
    '';

  return {
    id: row?.id,
    userName,
    email,
    certificateTitle:
      row?.certificateTitle ||
      row?.certificate_title ||
      payload.certificateTitle ||
      `Sertifikat ${workshopTitle || 'Workshop'}`,
    type: row?.type || row?.certificate_type || payload.type || 'Workshop',
    workshopId: row?.workshopId || row?.workshop_id || payload.workshopId || '',
    workshopTitle,
    completedAt: row?.completedAt || row?.completed_at || payload.completedAt || '',
    issuedAt: row?.issuedAt || row?.issued_at || payload.issuedAt || '',
    certificateNumber:
      row?.certificateNumber ||
      row?.certificate_number ||
      payload.certificateNumber ||
      '-',
    description: payload.description || payload.certificateDescription || '',
    instructor: payload.instructor || payload.instructorName || '',
    organizer: payload.organizer || 'Arduflow',
    status: row?.status || payload.status || 'Menunggu',
    downloads: Number(row?.downloads ?? payload.downloads ?? 0),
    file,
    createdAt: row?.createdAt || row?.created_at || '',
    updatedAt: row?.updatedAt || row?.updated_at || '',
  };
}

function normalizeWorkshopOption(row) {
  const payload = row?.payload || {};

  return {
    id: row?.id,
    title: row?.title || payload.title || 'Workshop tanpa judul',
    category: row?.category || payload.category || 'Workshop',
