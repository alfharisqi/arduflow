{
  "name": "arduflow/php-api",
  "description": "ArduFlow PHP API migration target",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "phpmailer/phpmailer": "^7.1",
    "vinsaj9/scrypt": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Arduflow\\Api\\": "app/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8000 router.php",
    "db:init": "php scripts/init-sqlite.php",
    "db:import-auth": "php scripts/import-auth-from-node-sqlite.php",
    "db:import": "php scripts/import-mysql-to-sqlite.php",
    "db:check": "php scripts/check-database-consistency.php",
    "db:backup": "php scripts/backup-sqlite.php",
    "db:seed-admin": "php scripts/seed-admin.php",
    "sync:run": "php scripts/sync-sqlite-to-mysql.php",
    "sync:schedule:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows-sync-scheduler.ps1",
    "test:auth": "php tests/auth-integration.php",
    "test:sync": "php tests/sync-integration.php",
    "test:content": "php tests/content-integration.php",
    "test": [
      "@test:auth",
      "@test:sync",
      "@test:content"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
