APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:4173
APP_TIMEZONE=Asia/Jakarta
AUTH_SESSION_HOURS=8
AUTH_LEGACY_SCRYPT_ENABLED=false

SQLITE_DATABASE_PATH=storage/database/arduflow.sqlite
NODE_SQLITE_DATABASE_PATH=../BE/storage/database/arduflow.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_arduflow
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Arduflow <no-reply@arduflow.local>
MAIL_ENABLED=true

SYNC_ENABLED=true
SYNC_API_URL=http://127.0.0.1:8000/api/internal/sync/sqlite-to-mysql
SYNC_API_TOKEN=ganti_token_random
SYNC_HMAC_SECRET=ganti_secret_random
SYNC_MAX_CLOCK_SKEW_SECONDS=300
SYNC_BATCH_SIZE=250
SYNC_HTTP_TIMEOUT_SECONDS=30
SYNC_PROCESSING_TIMEOUT_MINUTES=15
SYNC_IP_ALLOWLIST=

MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=arduflow-php-api
MQTT_TOPIC_PREFIX=arduflow
MQTT_TIMEOUT_SECONDS=2

SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_DIRECTORY=storage/backups/sqlite
SQLITE_BACKUP_RETENTION_DAYS=14

ADMIN_SEED_USERNAME=adminarduflow2026
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin Arduflow
ADMIN_SEED_EMAIL=admin@arduflow.local
ADMIN_SEED_ROLE=super_admin
