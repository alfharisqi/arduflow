API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# Operational database (private server filesystem)
SQLITE_DATABASE_PATH=storage/database/arduflow.sqlite

# Central/backup database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_arduflow
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECT_TIMEOUT_MS=3000

# SQLite -> MySQL synchronization
SYNC_ENABLED=true
SYNC_API_URL=http://127.0.0.1:3001/api/internal/sync/sqlite-to-mysql
SYNC_API_TOKEN=replace-with-a-long-random-token
SYNC_HMAC_SECRET=replace-with-a-different-long-random-secret
SYNC_MAX_CLOCK_SKEW_SECONDS=300
SYNC_BATCH_SIZE=250
SYNC_PROCESSING_TIMEOUT_MINUTES=15
SYNC_IP_ALLOWLIST=127.0.0.1,::1

# SQLite backups
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_DIRECTORY=storage/backups/sqlite
SQLITE_BACKUP_RETENTION_DAYS=14

# SMTP / Mailpit
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Arduflow <no-reply@arduflow.local>"

# Local admin seed. Never commit real credentials.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin Arduflow
ADMIN_SEED_EMAIL=
ADMIN_SEED_ROLE=super_admin

