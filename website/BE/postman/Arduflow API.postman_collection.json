{
  "info": {
    "_postman_id": "4bb2ffde-7f26-4b89-85ce-5b1b53f48fc2",
    "name": "Arduflow API - SQLite Primary",
    "description": "Collection pengujian API Arduflow. Urutan folder dirancang untuk Collection Runner. SQLite adalah database operasional; MySQL hanya diperiksa melalui health dan API sinkronisasi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('SQLite adalah database utama', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.primaryDatabase).to.eql('sqlite');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Database Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health/database"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('SQLite sehat dan writable', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.sqlite.status).to.eql('healthy');",
                  "  pm.expect(json.sqlite.writable).to.eql(true);",
                  "});",
                  "pm.test('MySQL tidak wajib untuk request user', () => {",
                  "  pm.expect(pm.response.json().mysql.required_for_user_request).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - User Authentication",
      "item": [
        {
          "name": "Check Availability Before Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.environment.set('user_email', 'postman.' + suffix + '@example.com');",
                  "pm.environment.set('user_whatsapp', '+628' + suffix.slice(-10));",
                  "pm.environment.set('user_whatsapp_encoded', encodeURIComponent('+628' + suffix.slice(-10)));",
                  "pm.environment.set('user_username', 'postman' + suffix.slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Email dan WhatsApp tersedia', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.emailAvailable).to.eql(true);",
                  "  pm.expect(json.whatsappAvailable).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/check-availability?email={{user_email}}&whatsapp={{user_whatsapp_encoded}}"
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
