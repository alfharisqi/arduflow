    {
      "name": "02 - Email Verification (Optional Mailpit)",
      "description": "Set run_mailpit_tests=true dan jalankan Mailpit pada mailpit_url untuk mengaktifkan folder ini.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (String(pm.environment.get('run_mailpit_tests')).toLowerCase() !== 'true') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Find Verification Message",
          "request": {
            "method": "GET",
            "url": "{{mailpit_url}}/api/v1/messages?limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mailpit dapat diakses', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const messages = json.messages || json.Messages || [];",
                  "const email = pm.environment.get('user_email');",
                  "const message = messages.find((item) => JSON.stringify(item).includes(email)) || messages[0];",
                  "pm.test('Email verifikasi ditemukan', () => pm.expect(message).to.exist);",
                  "if (message) pm.environment.set('mailpit_message_id', message.ID || message.Id || message.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Extract Verification Token",
          "request": {
            "method": "GET",
            "url": "{{mailpit_url}}/api/v1/message/{{mailpit_message_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Detail email tersedia', () => pm.response.to.have.status(200));",
                  "const match = pm.response.text().match(/verify-email\\?token=([a-f0-9]+)/i);",
                  "pm.test('Token ditemukan dalam email', () => pm.expect(match).to.exist);",
                  "if (match) pm.environment.set('verification_token', match[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verification_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/verify-email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email berhasil diverifikasi', () => pm.response.to.have.status(200));",
                  "pm.test('Status user terverifikasi', () => pm.expect(pm.response.json().user.emailVerified).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
