            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User Test\",\n  \"email\": \"user.test@example.com\",\n  \"whatsapp\": \"+6281234567890\",\n  \"occupation\": \"mahasiswa\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
