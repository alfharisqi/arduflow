              "mode": "raw",
              "raw": "{\n  \"name\": \"{{user_name}}\",\n  \"email\": \"{{user_email}}\",\n  \"whatsapp\": \"{{user_whatsapp}}\",\n  \"occupation\": \"Developer\",\n  \"password\": \"{{user_password}}\"\n}",
