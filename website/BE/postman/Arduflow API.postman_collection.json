    {
      "name": "06 - Database Sync Admin",
      "item": [
        {
          "name": "Get Sync Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/database-sync/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statistik outbox tersedia', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.pending).to.be.a('number');",
                  "  pm.expect(json.processing).to.be.a('number');",
                  "  pm.expect(json.failed).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Run Sync Worker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/database-sync/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
